{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workspace-guard:commit-plan:v1",
  "title": "Agent Workspace Guard Commit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "plan_id",
    "transaction_id",
    "task_id",
    "workspace_root",
    "baseline_digest",
    "staged_digest",
    "policy_digest",
    "changes",
    "findings",
    "decision",
    "created_at",
    "expires_at",
    "summary",
    "fingerprint",
    "signature",
    "state"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]{16,128}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^tx_[A-Za-z0-9_-]{16,128}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "baseline_digest": {
      "$ref": "#/$defs/digest"
    },
    "staged_digest": {
      "$ref": "#/$defs/digest"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      },
      "maxItems": 20000
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 20000
    },
    "decision": {
      "enum": [
        "allow",
        "require_approval",
        "deny"
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "state": {
      "enum": [
        "pending",
        "committed",
        "invalidated"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "mode",
        "size",
        "digest",
        "link_target"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768,
          "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "special"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string",
          "maxLength": 64
        },
        "link_target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32768
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "before",
        "after"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768,
          "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
        },
        "kind": {
          "enum": [
            "add",
            "modify",
            "delete",
            "type_change"
          ]
        },
        "before": {
          "oneOf": [
            {
              "$ref": "#/$defs/entry"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "oneOf": [
            {
              "$ref": "#/$defs/entry"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
